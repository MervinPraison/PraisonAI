# Rust build output. Large, machine-specific, and regenerated by any build.
src-tauri/target/

# Transient copies the engine contract's ledger probe writes BESIDE the real
# contract (engines/src/conformance.test.ts). They exist for the life of one
# spawned child and are removed in a `finally` -- ignored so a crashed run
# cannot leave a hollowed copy of the contract staged for commit.
engines/src/*.probe-*.ts
