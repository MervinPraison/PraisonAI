node_modules/
dist/
# Rust build output. Large, machine-specific, and regenerated by any build.
src-tauri/target/

# Transient copies the ledger probes write BESIDE the real contract -- the
# engine probe (engines/src/conformance.test.ts) and the adapter probe
# (adapters/src/conformance/contracts.test.ts). They exist for the life of one
# spawned child and are removed in a `finally` -- ignored so a crashed run
# cannot leave a hollowed copy of a contract staged for commit.
engines/src/*.probe-*.ts
adapters/src/conformance/*.probe-*.ts
