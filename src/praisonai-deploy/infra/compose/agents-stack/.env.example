# Copy to .env and adjust for local/production use.
# praisonai deploy compose up loads this automatically when present.

AGENTS_FILE=./agents.yaml
API_PORT=8005
POSTGRES_PORT=5432
POSTGRES_USER=praisonai
POSTGRES_PASSWORD=change-me
POSTGRES_DB=praisonai
PRAISONAI_IMAGE=ghcr.io/mervinpraison/praisonai:latest

# Required for agent LLM calls inside the API container:
# OPENAI_API_KEY=sk-...

# Optional API bearer token (auto-generated if empty and auth enabled):
# PRAISONAI_API_TOKEN=
