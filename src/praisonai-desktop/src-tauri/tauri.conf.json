{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PraisonAI",
  "version": "0.1.0",
  "identifier": "ai.praison.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "PraisonAI",
        "width": 980,
        "height": 720,
        "minWidth": 560,
        "minHeight": 420,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": {
      "../engine": "engine"
    }
  }
}
